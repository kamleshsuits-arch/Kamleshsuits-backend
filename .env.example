# Existing backend settings belong above this section.

# WhatsApp Cloud API order-status notifications
# The approved template body must accept variables in this order:
# {{1}} order ID, {{2}} order status, {{3}} order total.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_STATUS_TEMPLATE=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# Browser Web Push. Generate once with: node scripts/setupVapidKeys.js
# Keep VAPID_PRIVATE_KEY secret and configure the same values on Render.
VAPID_SUBJECT=mailto:support@kamleshsuits.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
